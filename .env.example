# Optional. Offline baseline requires no API key.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
PORT=3000

# Shared-key mode additionally requires DEMO_ACCESS_CODE and BUDGET_DB.
# Configure the D1 binding in Cloudflare; never put a database ID in a secret value.
DEMO_ACCESS_CODE=
DAILY_CALL_LIMIT=100
